# Cloud Run image: the same application as the root Dockerfile, but running the MCP
# server and the API together behind one port (see deploy/cloud_run_start.py for why).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY scripts/ ./scripts/
COPY deploy/cloud_run_start.py ./deploy/cloud_run_start.py
COPY pyproject.toml ./

RUN useradd --create-home --uid 10001 analyst && chown -R analyst:analyst /app
USER analyst

# Cloud Run sets PORT; the supervisor reads it and binds the API there.
ENV PORT=8080
EXPOSE 8080

CMD ["python", "deploy/cloud_run_start.py"]
