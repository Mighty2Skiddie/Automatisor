# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM (required) -----------------------------------------------------------
# Free key, no card required: https://aistudio.google.com  ->  Get API key
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# --- LLM fallback (optional but recommended) ----------------------------------
# Free key, no card: https://console.groq.com  ->  API Keys
# When Gemini is rate-limited or erroring, the agent transparently fails over to
# Groq. Leave GROQ_API_KEY blank to run on Gemini alone.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER_ORDER=google,groq

# --- MCP server ---------------------------------------------------------------
# The agent reaches the database only through this URL. Binding to 0.0.0.0 lets the
# api container reach the mcp container under docker compose; MCP_SERVER_URL is what
# the client dials, and is overridden to http://mcp:8765/mcp inside compose.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_SERVER_URL=http://127.0.0.1:8765/mcp

# --- Database -----------------------------------------------------------------
DB_PATH=app/data/financials.db

# --- Observability (optional) -------------------------------------------------
# Leave blank to run with tracing disabled. https://cloud.langfuse.com -> new project
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
